<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules xmlns:android="http://schemas.android.com/apk/res/android">
    <cloud-backup>
        <!-- Exclude all hardware-backed keystore vaults and credentials from cloud auto-backup -->
        <exclude domain="sharedpref" path="opened_keystore_vault.xml" />
        <exclude domain="sharedpref" path="opened_secure_vault.xml" />
        <exclude domain="sharedpref" path="opened_secure_vault_fallback.xml" />
        <!-- Exclude temporary exports and cache -->
        <exclude domain="cache" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Hardware-backed Keystore keys are non-exportable and cannot be decrypted on a new device -->
        <exclude domain="sharedpref" path="opened_keystore_vault.xml" />
        <exclude domain="sharedpref" path="opened_secure_vault.xml" />
        <exclude domain="sharedpref" path="opened_secure_vault_fallback.xml" />
        <exclude domain="cache" path="." />
    </device-transfer>
</data-extraction-rules>
